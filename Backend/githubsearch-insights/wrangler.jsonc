{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githubsearch-insights",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "INSIGHTS_RATE_LIMITER",
      "namespace_id": "2609071731",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
